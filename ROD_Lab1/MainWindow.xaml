<Window x:Class="ROD_Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ROD_Lab1"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1800"
        Background="AliceBlue">
    <Grid Margin="10" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="5,0" Background="White" >
            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock FontFamily="Arial" FontSize="20"
                           Text="Определение границ"
                           HorizontalAlignment="Center" Margin="0,10"/>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="A"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox    Margin="3,10" Width="60"
                                    Text="{Binding TestString, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    />
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="i+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="j+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"
                                 Text=""/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="AA"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="i+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="j+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="B"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="j+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="k+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="BB"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="j+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="k+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="C"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="i+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="k+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="CC"
                                   HorizontalAlignment="Left" Margin="0,10" Width="40"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text=":"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="i+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                        <TextBlock FontFamily="Arial" FontSize="20"
                                   Text="k+"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Margin="3,10" Width="60"/>
                    </StackPanel>
                </Border>
                
                <TextBlock  FontFamily="Arial" FontSize="20"
                            Text="Размеры"
                            HorizontalAlignment="Center" Margin="0,10"/>

                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   FontFamily="Arial" FontSize="20"
                                   Text="iActualSize"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Margin="0,10" 
                                 Text="{Binding iActualSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                   FontFamily="Arial" FontSize="20"
                                   Text="jActualSize"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Margin="0,10"
                                 Text="{Binding jActualSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                   FontFamily="Arial" FontSize="20"
                                   Text="kActualSize"
                                   HorizontalAlignment="Left" Margin="0,10"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Margin="0,10"
                                 Text="{Binding kActualSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <TextBlock  FontFamily="Arial" FontSize="20"
                            Text="Параметры"
                            HorizontalAlignment="Center" Margin="0,10"/>

                <Border BorderBrush="DarkCyan" BorderThickness="1" Padding="5,0" Margin="0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
        
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       FontFamily="Arial" FontSize="20"
                                       Text="a"
                                       HorizontalAlignment="Left" Margin="0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" 
                                     Margin="0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       FontFamily="Arial" FontSize="20"
                                       Text="tau"
                                       HorizontalAlignment="Left" Margin="0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                     Margin="0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       FontFamily="Arial" FontSize="20"
                                       Text="h"
                                       HorizontalAlignment="Left" Margin="0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                     Margin="0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                       FontFamily="Arial" FontSize="20"
                                       Text="tMax"
                                       HorizontalAlignment="Left" Margin="0,10"/>
                            <TextBox Grid.Row="3" Grid.Column="1" 
                                     Margin="0,10" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock  FontFamily="Arial" FontSize="20"
                                        Text="(tau * a * a) / (h * h) &lt; 0.125"
                                        HorizontalAlignment="Center" Margin="0,10"/>
                            <TextBlock  FontFamily="Arial" FontSize="20"
                                        Text="(true)"
                                        HorizontalAlignment="Center" Margin="10,10"/>
                        </StackPanel>
                        
                    </Grid>

                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="15,10" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="5"
                        />

                <Slider Grid.Column="1" VerticalAlignment="Center" Margin="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
